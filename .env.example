# DropAI Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Database Connection (SQLite local dev or PostgreSQL on Supabase/Neon/Railway for production)
DATABASE_URL="file:./dev.db"

# Session & JWT Security (Generate a secure random string)
JWT_SECRET="dropai_super_secure_production_jwt_key_998822_random_secret_string"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DropAI"

# ==============================================================================
# FIREBASE CLIENT CONFIGURATION (Required for Google Auth & Client Sign-in)
# Obtain these from: Firebase Console -> Project Settings -> General -> Web Apps
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ==============================================================================
# FIREBASE ADMIN SDK CONFIGURATION (Required for secure server verification & custom claims)
# Obtain these from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# ==============================================================================
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# OPTIONAL INTEGRATIONS
# ==============================================================================
OPENAI_API_KEY="mock_ai_key"
SHOPIFY_API_KEY="mock_shopify_key"
SHOPIFY_API_SECRET="mock_shopify_secret"
STRIPE_SECRET_KEY="mock_stripe_key"
STRIPE_WEBHOOK_SECRET="mock_stripe_webhook_secret"
