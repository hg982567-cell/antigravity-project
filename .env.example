# ===================================================
# DropAI Production Environment Configuration
# ===================================================

# ---------------------------------------------------
# 1. Firebase Authentication - Client SDK (Frontend)
# ---------------------------------------------------
# Found in: Firebase Console -> Project Settings -> General -> "Your apps" -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="dropai-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="dropai-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="dropai-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ---------------------------------------------------
# 2. Firebase Admin SDK (Server-Side ID Token Verification)
# ---------------------------------------------------
# Found in: Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
FIREBASE_PROJECT_ID="dropai-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@dropai-project.iam.gserviceaccount.com"
# Note: For Vercel or production envs, wrap the private key in double quotes and preserve \n:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------
# 3. Database Connection
# ---------------------------------------------------
# For Vercel Production, use Neon Serverless Postgres (neon.tech) or Supabase (supabase.com)
# Pooled connection string (used at runtime by Next.js lambdas)
DATABASE_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/dropai?sslmode=require&pgbouncer=true"

# Direct unpooled connection string (used by Prisma migrations and CLI)
DIRECT_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/dropai?sslmode=require"

# ---------------------------------------------------
# 4. Session & Cryptographic Security
# ---------------------------------------------------
# JWT & Authentication Secret (Generate a strong 32+ char random string)
JWT_SECRET="dropai_super_secure_production_jwt_key_998822_random_secret_string"

# Environment Mode
NODE_ENV="production"

# Application Public URLs
NEXT_PUBLIC_APP_URL="https://your-dropai-domain.vercel.app"
NEXT_PUBLIC_APP_NAME="DropAI"

# Optional Cloud Database Seeding Secret (Protects /api/app/seed endpoint)
SEED_SECRET="dropai_seed_secure_token_77123"

# ---------------------------------------------------
# 5. External Integrations (Optional)
# ---------------------------------------------------
OPENAI_API_KEY=""
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
