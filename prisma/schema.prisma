generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String          @id @default(cuid())
  firebaseUid       String?         @unique
  email             String          @unique
  passwordHash      String?         // Never store user passwords; Firebase handles authentication
  name              String
  role              String          @default("MERCHANT") // OWNER, ADMIN, MERCHANT, VIEWER
  status            String          @default("EMAIL_UNVERIFIED") // ACTIVE, EMAIL_UNVERIFIED, SUSPENDED, DISABLED
  avatarUrl         String?
  isEmailVerified   Boolean         @default(false)
  twoFactorEnabled  Boolean         @default(false)
  twoFactorSecret   String?
  recoveryCodes     String?         // Hashed backup recovery codes
  isSuspended       Boolean         @default(false)
  suspendedReason   String?
  suspendedAt       DateTime?
  deletedAt         DateTime?       // Soft-delete timestamp
  failedLoginAttempts Int           @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sessions          Session[]
  securityEvents    SecurityEvent[]
  auditLogs         AuditLog[]
  ownerAuditLogs    OwnerAuditLog[]
  stores            Store[]
  products          Product[]
  orders            Order[]
  customers         Customer[]
  automations       Automation[]
  notifications     Notification[]
  adCampaigns       AdCampaign[]
  aiRequests        AiRequest[]
  subscription      Subscription?
  socialAccounts    SocialAccount[]
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String    @unique
  ipAddress     String
  userAgent     String
  deviceType    String    // Desktop, Mobile, Tablet
  browser       String    // Chrome, Firefox, Safari, Edge
  location      String    // e.g. "New York, US"
  isValid       Boolean   @default(true)
  lastActiveAt  DateTime  @default(now())
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String   // LOGIN_SUCCESS, LOGIN_FAIL, 2FA_ENABLE, PASSWORD_RESET, SESSION_REVOKED
  ipAddress   String
  userAgent   String?
  location    String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId     String?
  action      String   // CREATE, UPDATE, DELETE, IMPORT, EXPORT, CONNECT, DISCONNECT, EXECUTE_AI
  entityType  String   // PRODUCT, ORDER, SUPPLIER, STORE, AUTOMATION, SETTINGS
  entityId    String?
  oldValue    String?  // JSON string
  newValue    String?  // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Store {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  platform       String           // SHOPIFY, WOOCOMMERCE, BIGCOMMERCE, CUSTOM
  storeUrl       String
  status         String           @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  currency       String           @default("USD")
  country        String           @default("US")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  connections    StoreConnection[]
  products       Product[]
  orders         Order[]
  customers      Customer[]
  automations    Automation[]
  adCampaigns    AdCampaign[]
}

model StoreConnection {
  id                   String    @id @default(cuid())
  storeId              String
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform             String
  apiKeyEncrypted      String?
  apiSecretEncrypted   String?
  accessTokenEncrypted String?
  webhookSecret        String?
  scopes               String?
  lastSyncAt           DateTime?
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Supplier {
  id                   String            @id @default(cuid())
  name                 String
  platform             String            // ALIEXPRESS, CJ_DROPSHIPPING, ZENDROP, SPOCKET, DIRECT
  rating               Float             @default(4.8)
  fulfillmentSpeedDays Int               @default(7)
  returnPolicy         String            @default("30-day buyer protection")
  country              String            @default("CN")
  websiteUrl           String?
  contactEmail         String?
  reliabilityScore     Float             @default(95.0)
  totalOrdersFulfilled Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  supplierProducts     SupplierProduct[]
}

model Product {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId           String?
  store             Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  title             String
  slug              String
  description       String
  sku               String             @unique
  category          String
  status            String             @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  sellingPrice      Float
  costPrice         Float
  compareAtPrice    Float?
  inventory         Int                @default(0)
  images            String             // JSON array of image URLs
  tags              String?            // comma-separated or JSON
  countryTarget     String             @default("US")
  aiScore           Float              @default(85.0)
  demandScore       Float              @default(88.0)
  competitionScore  Float              @default(42.0)
  marginScore       Float              @default(78.0)
  trendScore        Float              @default(91.0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  variants          ProductVariant[]
  supplierProducts  SupplierProduct[]
  orderItems        OrderItem[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  title      String      // e.g. "Midnight Black / M"
  sku        String      @unique
  price      Float
  cost       Float
  inventory  Int         @default(0)
  options    String?     // JSON of attributes e.g. {"Color": "Black", "Size": "M"}
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  orderItems OrderItem[]
}

model SupplierProduct {
  id             String    @id @default(cuid())
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalId     String?
  sourceUrl      String?
  unitCost       Float
  shippingCost   Float     @default(0.0)
  stockQuantity  Int       @default(1000)
  deliveryDays   Int       @default(7)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Customer {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?
  country      String    @default("US")
  city         String?
  totalSpent   Float     @default(0.0)
  ordersCount  Int       @default(0)
  riskScore    Float     @default(5.0) // 0-100 fraud risk score
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]
}

model Order {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId            String?
  store              Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber        String       @unique
  status             String       @default("PAID") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  financialStatus    String       @default("PAID") // PENDING, PAID, REFUNDED, PARTIALLY_REFUNDED
  fulfillmentStatus  String       @default("UNFULFILLED") // UNFULFILLED, PROCESSING, SHIPPED, DELIVERED
  totalAmount        Float
  subtotalAmount     Float
  taxAmount          Float        @default(0.0)
  shippingAmount     Float        @default(0.0)
  profitAmount       Float        @default(0.0)
  currency           String       @default("USD")
  riskLevel          String       @default("LOW") // LOW, MEDIUM, HIGH
  idempotencyKey     String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  items              OrderItem[]
  shipments          Shipment[]
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title      String
  quantity   Int
  price      Float
  cost       Float
  total      Float
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String    // USPS, DHL, FEDEX, YUNEXPRESS, EPACKET
  trackingNumber    String    @unique
  trackingUrl       String?
  status            String    @default("IN_TRANSIT") // LABEL_CREATED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION
  estimatedDelivery DateTime?
  shippingCost      Float     @default(0.0)
  eventsJson        String?   // JSON array of milestone events
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AdCampaign {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  platform     String    // META, GOOGLE, TIKTOK, YOUTUBE
  campaignName String
  status       String    @default("ACTIVE") // ACTIVE, PAUSED, DRAFT, ENDED
  dailyBudget  Float
  totalSpend   Float     @default(0.0)
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  conversions  Int       @default(0)
  roas         Float     @default(0.0)
  revenue      Float     @default(0.0)
  cpc          Float     @default(0.0)
  cpm          Float     @default(0.0)
  ctr          Float     @default(0.0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Automation {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId           String?
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  name              String
  triggerType       String          // LOW_INVENTORY, HIGH_RISK_ORDER, COMPETITOR_PRICE_DROP, NEW_ORDER, FULFILLMENT_DELAY
  conditionsJson    String          // JSON rule criteria
  aiPrompt          String?         // Optional AI reasoning prompt
  actionType        String          // SWITCH_SUPPLIER, HOLD_ORDER, ADJUST_PRICE, NOTIFY_MERCHANT, AUTO_FULFILL
  actionPayloadJson String?         // JSON action params
  isEnabled         Boolean         @default(true)
  runCount          Int             @default(0)
  lastRunAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  runs              AutomationRun[]
}

model AutomationRun {
  id              String      @id @default(cuid())
  automationId    String
  automation      Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status          String      // SUCCESS, FAILED, REQUIRE_APPROVAL
  triggerDataJson String?
  resultDataJson  String?
  errorMessage    String?
  executedAt      DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // INFO, WARNING, ALERT, SUCCESS
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AiRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          String   // PRODUCT_RESEARCH, PRICING, ADS, ASSISTANT, AUTOMATION
  prompt          String
  response        String
  toolCallsJson   String?  // JSON structured tool logs
  tokensUsed      Int      @default(0)
  executionTimeMs Int      @default(0)
  createdAt       DateTime @default(now())
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                String    @default("PRO") // FREE, STARTER, PRO, ENTERPRISE
  status              String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  currentPeriodEnd    DateTime
  aiCreditsRemaining  Int       @default(5000)
  aiCreditsTotal      Int       @default(5000)
  ordersProcessedThisMonth Int  @default(0)
  storesLimit         Int       @default(5)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model OwnerAuditLog {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  action        String   // USER_SUSPEND, USER_DELETE, AI_PROVIDER_UPDATE, EMERGENCY_LOCKDOWN, etc.
  targetType    String   // USER, AI, SUBSCRIPTION, SHIPPING, PROFIT, SYSTEM, API, SECURITY
  targetId      String?
  previousValue String?  // JSON string
  newValue      String?  // JSON string
  result        String   @default("SUCCESS") // SUCCESS, REJECTED, FAILED
  severity      String   @default("INFO") // INFO, WARNING, HIGH, CRITICAL
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // JSON or string value
  category    String   // GENERAL, BILLING, AI, SECURITY, MAINTENANCE
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model FeatureFlag {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String
  isEnabled    Boolean  @default(true)
  scope        String   @default("GLOBAL") // GLOBAL, PLAN, USER
  targetPlan   String?
  targetUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AiProviderConfig {
  id                 String   @id @default(cuid())
  provider           String   @unique // OPENAI, ANTHROPIC, GOOGLE, CUSTOM
  displayName        String
  protocol           String   @default("OPENAI_COMPATIBLE") // OPENAI_COMPATIBLE, GOOGLE_GEMINI, ANTHROPIC
  apiKeyEncrypted    String?
  baseUrl            String?
  status             String   @default("ACTIVE") // ACTIVE, DISABLED, ERROR, NOT_CONFIGURED
  priority           Int      @default(1)
  isDefault          Boolean  @default(false)
  modelsJson         String   @default("[]") // JSON array of model names
  rateLimitPerMin    Int      @default(60)
  dailyTokenLimit    Int      @default(1000000)
  currentDayTokens   Int      @default(0)
  fallbackProviderId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiRoutingRule {
  id            String   @id @default(cuid())
  taskType      String   @unique // PRODUCT_RESEARCH, AD_GENERATION, CUSTOMER_SUPPORT, PRICING, FRAUD_ANALYSIS, AUTOMATION, ANALYTICS
  providerName  String   // OPENAI, ANTHROPIC, GOOGLE
  modelName     String   // e.g. "gpt-4o", "claude-3-5-sonnet", "gemini-1.5-pro"
  fallbackModel String?
  temperature   Float    @default(0.7)
  maxTokens     Int      @default(2048)
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  code            String   @unique // FREE, STARTER, PRO, BUSINESS, ENTERPRISE
  name            String
  priceMonthly    Float
  priceYearly     Float
  currency        String   @default("USD")
  productLimit    Int
  storeLimit      Int
  orderLimit      Int
  aiCreditsLimit  Int
  automationLimit Int
  apiAccess       Boolean  @default(false)
  supportLevel    String   // COMMUNITY, EMAIL, PRIORITY_24_7, DEDICATED
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ShippingRule {
  id                   String   @id @default(cuid())
  scope                String   @default("GLOBAL") // GLOBAL, PLAN, USER
  targetPlan           String?
  targetUserId         String?
  countryCode          String   @default("*")
  methodName           String   // Standard, Express, YunExpress, ePacket
  baseCost             Float
  deliveryDaysEstimate String
  isRestricted         Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ProfitRule {
  id                   String   @id @default(cuid())
  scope                String   @default("GLOBAL") // GLOBAL, PLAN, USER
  targetPlan           String?
  targetUserId         String?
  defaultMarginPercent Float    @default(35.0)
  minMarginPercent     Float    @default(15.0)
  maxMarginPercent     Float    @default(85.0)
  productMarkup        Float    @default(2.5)
  shippingMarkup       Float    @default(1.2)
  platformFeePercent   Float    @default(2.5)
  aiFeePerRequest      Float    @default(0.02)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ApiIntegration {
  id                 String    @id @default(cuid())
  provider           String    @unique // SHOPIFY, STRIPE, OPENAI, CJ_DROPSHIPPING, ZENDROP, META, TIKTOK, GOOGLE_ADS
  displayName        String
  category           String    // STORE, PAYMENT, AI, SUPPLIER, ADS
  status             String    @default("NOT_CONFIGURED") // CONNECTED, DISCONNECTED, ERROR, DISABLED, NOT_CONFIGURED
  apiKeyMasked       String?   // "••••••••••••7X92"
  apiSecretEncrypted String?
  webhookUrl         String?
  lastTestedAt       DateTime?
  latencyMs          Int?
  errorLog           String?
  updatedAt          DateTime  @updatedAt
}

model EmergencyLockdown {
  id                   String    @id @default("singleton")
  isActive             Boolean   @default(false)
  disableRegistrations Boolean   @default(false)
  disableAiServices    Boolean   @default(false)
  disableApis          Boolean   @default(false)
  maintenanceMode      Boolean   @default(false)
  freezeFinancials     Boolean   @default(false)
  activatedAt          DateTime?
  activatedBy          String?
  reason               String?
}

model SocialAccount {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String         // INSTAGRAM, TIKTOK, FACEBOOK, YOUTUBE, TWITTER, PINTEREST, LINKEDIN, OTHER
  accountName     String         // e.g. "@mystore_official"
  displayName     String         // e.g. "Viral Finds IG"
  profileUrl      String?
  accessToken     String?        // Secure API token or webhook
  refreshToken    String?
  apiKey          String?
  apiSecret       String?
  webhookUrl      String?        // Automation webhook (e.g. Zapier, Make, n8n, Publer, Buffer, or Direct)
  status          String         @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  autoPublishAds  Boolean        @default(true)
  totalPosts      Int            @default(0)
  lastPostedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  adPosts         SocialAdPost[]
}

model SocialAdPost {
  id              String        @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  adTitle         String
  caption         String
  hook            String?
  cta             String?
  mediaUrl        String?
  platform        String
  status          String        @default("PUBLISHED") // PUBLISHED, SCHEDULED, FAILED
  scheduledFor    DateTime?
  publishedAt     DateTime?     @default(now())
  externalPostId  String?
  createdAt       DateTime      @default(now())
}

model DocumentationArticle {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  description      String
  content          String            @db.Text
  category         String            // getting-started, product-research-ai, shopify-integrations, automations-fulfillment, orders, payments-currency, security-account, troubleshooting, developer-api, admin-system
  subcategory      String?
  tags             String            // Comma-separated or JSON string
  status           String            @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED
  author           String            @default("DropAI Engineering")
  readingTime      String            @default("5 min read")
  featured         Boolean           @default(false)
  visibility       String            @default("PUBLIC") // PUBLIC, AUTHENTICATED, ADMIN_ONLY
  sortOrder        Int               @default(0)
  helpfulYes       Int               @default(0)
  helpfulNo        Int               @default(0)
  version          String            @default("1.0.0")
  relatedSlugs     String?           // Comma-separated slugs
  deprecated       Boolean           @default(false)
  deprecatedReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  feedbacks        ArticleFeedback[]
}

model ArticleFeedback {
  id         String               @id @default(cuid())
  articleId  String
  article    DocumentationArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId     String?
  isHelpful  Boolean
  comment    String?
  ipAddress  String?
  createdAt  DateTime             @default(now())
}

